# Shared secret checked on every request via the X-Internal-API-Key header.
# Must match FASTAPI_ML_API_KEY in server/.env - the Express layer is the only
# intended caller of this service.
ML_INTERNAL_API_KEY=replace-with-a-long-random-secret

# Optional overrides. Defaults resolve relative to this service's own folder:
# models/flight_fare_model.pkl and data/Indian_Domestic_Flight_Historical_Dataset_FINAL.parquet
# ML_MODEL_PATH=
# ML_DATA_PATH=
