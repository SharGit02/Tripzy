NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Neon/Postgres connection string. DATABASE_URL also works if you prefer that name.
NEON_URI=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret

# OpenWeather API key (https://openweathermap.org/api). Powers GET /api/weather.
OPEN_WEATHER_API=replace-with-your-openweather-key

# ── Flight Fare ML microservice (FastAPI, ml-microservice/) ─────────────
# Base URL of the local FastAPI service. Optional — defaults to
# http://127.0.0.1:8000 in code when unset.
# FASTAPI_ML_BASE_URL=http://127.0.0.1:8000

# Shared secret sent as X-Internal-API-Key on every call to the ML service.
# Must match ML_INTERNAL_API_KEY in ml-microservice/.env. Optional — the
# POST /flight-fare/predict endpoint answers 503 when it is missing.
FASTAPI_ML_API_KEY=replace-with-a-long-random-secret

# ── Gemini (generative AI) ───────────────────────────────────────────────
# Keys form a "waterfall dam": _1 is always preferred, and traffic only spills
# to _2 when _1's gate opens (quota exhausted, key rejected, or upstream error).
# Numbering is discovered at runtime, so adding GEMINI_API_KEY_6 here is the ONLY
# change needed to widen the waterfall — no code edit.
GEMINI_API_KEY_1=replace-with-your-gemini-key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional. Defaults shown.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=60000
