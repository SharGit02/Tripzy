NODE_ENV=development
PORT=5000

# Comma-separated frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Neon/Postgres. DATABASE_URL also works if you prefer that name.
NEON_URI=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret

# Optional. Weather endpoint returns 503 when unset.
OPEN_WEATHER_API=replace-with-your-openweather-key

# ML service (same container talks to 127.0.0.1:8000). Use the same secret for both keys.
FASTAPI_ML_BASE_URL=http://127.0.0.1:8000
FASTAPI_ML_API_KEY=replace-with-a-long-random-secret
ML_INTERNAL_API_KEY=replace-with-a-long-random-secret

# Optional artifact overrides. Defaults are ml-microservice/models and ml-microservice/data.
# ML_MODEL_PATH=
# ML_DATA_PATH=

# Gemini (itinerary). Numbered keys are tried in order.
GEMINI_API_KEY_1=replace-with-your-gemini-key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL_FALLBACKS=
# GEMINI_TIMEOUT_MS=60000

# Optional fallback providers.
# NVIDIA_API_KEY=
# OPENCODE_ZEN_API_KEY=
